class PWD(nn.Module):
    def __init__(self, c1, c2):
        super().__init__()
        # print(f"  -> PWD 成功初始化: c1={c1}, c2={c2}") # 减少刷屏，暂时注释
        self.conv = nn.Conv2d(c1 * 4, c2, 1, 1, 0, bias=False)
        self.bn = nn.BatchNorm2d(c2)
        self.act = nn.SiLU()

    def forward(self, x):
        y = dwt_init(x)
        return self.act(self.bn(self.conv(y)))

